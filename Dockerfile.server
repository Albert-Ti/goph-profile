FROM golang:1.26-alpine AS base
WORKDIR /app

FROM base AS build
COPY ./ ./
RUN go mod tidy
RUN go build -o gophprofile cmd/server/main.go

FROM base AS dev
COPY --from=build /app/gophprofile /app/gophprofile
ENTRYPOINT [ "/app/gophprofile" ]

