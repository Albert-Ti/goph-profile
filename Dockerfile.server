FROM golang:1.26-alpine AS base
WORKDIR /app

FROM base AS build
COPY go.mod go.sum ./
RUN go mod download
COPY ./ ./
RUN CGO_ENABLED=0 go build -o gophprofile cmd/server/main.go

FROM alpine:3.22 AS dev
COPY --from=build /app/migrations /app/migrations
COPY --from=build /app/gophprofile /app/gophprofile
ENTRYPOINT [ "/app/gophprofile" ]